# Copy to .env: copy .env.example .env
PORT=3001
NODE_ENV=development

# MongoDB Atlas (namuna — USER va PASSWORDni o‘zingiz yozing, parolni gitga qo‘shmang)
DATABASE_URL=mongodb+srv://USER:PASSWORD@backend.gci5wgw.mongodb.net/violet_Market?retryWrites=true&w=majority&appName=backend

# Agar "querySrv ECONNREFUSED" chiqsa — DNS bloklangan yoki SRV ishlamayapti:
# • VPN o‘chiring, DNS ni 8.8.8.8 qiling, yoki Atlasdan mongodb:// (bir nechta host:27017) standart qatorni oling va shu yerga yozing.
# • Tekshiruv: nslookup -type=SRV _mongodb._tcp.YOUR_CLUSTER_HOST.mongodb.net

# SRV ishlamasa — Atlas → Connect → Compass / VS Code: "standard connection string" (mongodb://host1:27017,host2:27017,...)
# DATABASE_URL_STANDARD=mongodb://USER:PASSWORD@shard-....mongodb.net:27017,shard-....mongodb.net:27017/violet_Market?tls=true&replicaSet=atlas-xxx-shard-0&authSource=admin

# Atlas: Network Access — IP ruxsati (masalan 0.0.0.0/0 test uchun), aks holda ulanish "timeout" yoki DNS xato beradi.

